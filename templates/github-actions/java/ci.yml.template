# Java CI 工作流
# 自动运行测试和构建，确保代码质量

name: {ci_name}

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 检出代码
      - name: Checkout code
        uses: actions/checkout@v4

      {setup_step}

      # 运行测试
      - name: Run tests
        run: |
          {test_command}

      # 构建项目
      - name: Build
        run: |
          {build_command}
