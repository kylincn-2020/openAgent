# Node.js CI 工作流
# 自动运行测试和构建，确保代码质量

name: {ci_name}

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # 检出代码
      - name: Checkout code
        uses: actions/checkout@v4

      # 设置 Node.js 环境，启用包管理器缓存
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "{node_version}"
          cache: "{package_manager}"

      # 安装依赖
      - name: Install dependencies
        run: |
          {install_command}

      # 运行测试
      - name: Run tests
        run: |
          {test_command}

      {build_step}
