# ============================================================
# OpenAI Configuration
# ============================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Optional: Specify model
# DEFAULT_MODEL=gpt-4o-mini

# ============================================================
# 智谱 GLM-4.7 Configuration (OpenAI 兼容协议)
# ============================================================
# 获取 API Key: https://open.bigmodel.cn/usercenter/apikeys

# 智谱 API Key（必需）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 智谱 API Base URL（使用 OpenAI 兼容端点）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 默认模型
# 可选模型: glm-4-flash, glm-4-plus, glm-4-air, glm-4-airx
# glm-4-plus: 最强性能，适合复杂任务
# glm-4-flash: 最快速度，适合简单任务
# glm-4-air: 平衡性能和速度
# glm-4-airx: 增强版平衡模型
DEFAULT_MODEL=glm-4-plus
